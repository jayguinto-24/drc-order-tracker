# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, Supabase, Vercel Postgres, etc).
# On Vercel, use the *pooled* connection string — serverless functions open a
# new connection per invocation and will exhaust a direct connection's limit.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Resend (https://resend.com) API key used to send discrepancy / new-despatch emails.
RESEND_API_KEY=""

# Sender address — must be on a domain verified in Resend.
EMAIL_FROM="BSSP Order Tracker <tracker@yourdomain.com>"

# Comma-separated recipient lists. Leave blank to disable that email type.
NOTIFY_DISPATCH_EMAILS="jason@drcswitchboards.com.au"
NOTIFY_DISCREPANCY_EMAILS="jason@drcswitchboards.com.au,david@drcswitchboards.com.au"
